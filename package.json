{
  "name": "letterpress",
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "test": "bun test; code=$?; tools/cleanup.sh; exit $code",
    "bench": "bun tools/bench.mjs",
    "bench:baseline": "bun tools/bench-baseline.ts",
    "bench:burst": "bun tools/bench-burst.ts",
    "bench:concurrency": "bun tools/bench-concurrency.ts",
    "bench:determinism": "bun tools/bench-determinism.ts",
    "bench:transfer": "bun tools/bench-transfer.ts",
    "bench:verify": "bun tools/bench-verify-cost.ts",
    "render": "bun src/cli.ts",
    "typecheck": "tsc --noEmit",
    "serve": "bun src/server.ts",
    "lint": "oxlint --max-warnings 0 src test tools viewer",
    "lint:ts": "bun tools/lint-ts.mjs",
    "dup": "bun tools/dup.mjs",
    "audit": "bun audit",
    "format:check": "oxfmt --check src test tools templates viewer README.md docs",
    "spell": "cspell --no-progress --fail-fast --config cspell.yaml README.md docs/*.md",
    "ratchet": "bun tools/ratchet.mjs",
    "check": "bun run format:check && bun run lint && bun run lint:ts && bun run spell && bun run typecheck && bun run dup && bun run ratchet && bun run comments",
    "coverage": "bun test --coverage --coverage-reporter=lcov && bun tools/coverage.mjs",
    "cleanup": "tools/cleanup.sh --all",
    "comments": "bun tools/lint-comments.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/bun": "^1.4.2",
    "cspell": "10.3.6",
    "jscpd": "5.4.1",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "typescript-api": "npm:typescript@5.9.3"
  },
  "peerDependenciesMeta": {},
  "optionalDependencies": {},
  "description": "Render HTML to PDF through Chromium's own print engine",
  "bin": {
    "letterpress": "src/cli.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhammedanasmithadi/letterpress.git"
  }
}
