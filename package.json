{
  "name": "letterpress",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "bench": "bun tools/bench.mjs",
    "render": "bun src/cli.ts",
    "typecheck": "tsc --noEmit",
    "serve": "bun src/server.ts",
    "lint": "eslint tools --max-warnings=0",
    "format:check": "prettier --check src test tools templates README.md docs",
    "spell": "cspell --no-progress --fail-fast --config cspell.yaml README.md docs/*.md",
    "ratchet": "bun tools/ratchet.mjs",
    "coverage": "bun test --coverage --coverage-reporter=lcov && bun tools/coverage.mjs"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@types/bun": "^1.4.2",
    "cspell": "10.3.6",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "peerDependenciesMeta": {},
  "optionalDependencies": {},
  "description": "Render HTML to PDF through Chromium's own print engine"
}
